{
  "name": "@app-connect/plugin-template",
  "version": "1.0.0",
  "description": "Minimal plugin template for RingCentral App Connect",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "start": "npm run prod",
    "prod": "npm run build && node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "serverless-http": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "ringcentral",
    "app-connect",
    "plugin",
    "template"
  ],
  "author": "Developer name",
  "license": "ISC",
  "overrides": {
    "express@4": {
      "debug": "4.4.3",
      ".": "$express"
    },
    "body-parser": {
      "debug": "4.4.3"
    },
    "send@0.19": {
      "debug": "4.4.3"
    },
    "finalhandler@1": {
      "debug": "4.4.3"
    },
    "proxy-addr@2": "2.0.8",
    "qs@6": "6.17.1",
    "follow-redirects@1": "1.16.2"
  }
}
